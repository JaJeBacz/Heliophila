BEGIN mrbayes;

log start filename=Helio.log replace;

set autoclose=yes nowarnings=no autoreplace=no;

lset nst=6 rates=invgamma;

mcmcp 
	nchains=4 
	ngen=5000000
	nruns=2 
	samplefreq=1000 
	savebrlens=yes
	printfreq=1000
	Mcmcdiagn=yes
	Diagnfreq=1000;
mcmc; 
	sumt burnin=0.25 cont=all;
	sump burnin=0.25;

log stop;

END;
